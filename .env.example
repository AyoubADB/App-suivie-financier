# ---------------------------------------------------------------------------
# Configuration Firebase — copie ce fichier en `.env` et remplis les valeurs.
#
# Où les trouver : console.firebase.google.com → ⚙️ Paramètres du projet
#   → « Vos applications » → application Web → Configuration du SDK
#
# Ces clés sont PUBLIQUES par nature : elles partent dans le bundle du
# navigateur, c'est normal et sans danger. Ce qui protège tes données, ce
# sont les règles de sécurité (firestore.rules) et l'authentification.
#
# ⚠️ N'y mets JAMAIS une clé de service account (`*-firebase-adminsdk-*.json`) :
# elle contourne toutes les règles et ne doit jamais toucher le code client.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ton-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ton-projet
VITE_FIREBASE_STORAGE_BUCKET=ton-projet.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# App Check (optionnel) — atteste que les requêtes viennent bien de ton app.
# Console Firebase → Créer → App Check → enregistrer l'app avec
# reCAPTCHA Enterprise, puis coller ici la CLÉ DE SITE (publique).
# Laisse vide tant que ce n'est pas configuré : l'app démarre sans.
# ---------------------------------------------------------------------------

VITE_FIREBASE_APPCHECK_SITE_KEY=

# Jeton de débogage pour travailler en local une fois l'enforcement activé.
# Console App Check → ton app → ⋮ → Gérer les jetons de débogage.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
