rules_version = '2';

// ---------------------------------------------------------------------------
// FLOW — règles de sécurité Firestore
//
// Deux niveaux de protection :
//   1. Propriété — un compte n'atteint que son propre sous-arbre users/{uid}.
//   2. Validation — la forme de chaque document est vérifiée côté serveur,
//      donc un client modifié ne peut pas injecter de données arbitraires
//      ni gonfler le stockage.
//
// Déploiement :  firebase deploy --only firestore:rules
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------- assistants

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Chaînes bornées : évite qu'un client écrive des mégaoctets de texte.
    function str(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function optionalStr(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isHexColor(value) {
      return value is string && value.matches('^#[0-9a-fA-F]{6}$');
    }

    function isIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------------------------------------------------------- transactions

    function validTransaction(d, txId) {
      return d.keys().hasAll([
               'id', 'type', 'scope', 'amount', 'currency', 'label',
               'categoryId', 'date', 'isRecurring', 'badges',
               'createdAt', 'updatedAt'
             ])
             && d.keys().hasOnly([
                  'id', 'type', 'scope', 'amount', 'currency', 'label',
                  'categoryId', 'date', 'isRecurring', 'recurringFrequency',
                  'nextDueDate', 'iconOverride', 'imageUrl', 'badges', 'note',
                  'activityId', 'splits', 'externalId', 'createdAt', 'updatedAt'
                ])
             && d.id == txId
             && d.type in ['expense', 'revenue']
             && d.scope in ['perso', 'pro']
             // Montants en centimes : entier strictement positif, plafonné à 10 M€.
             && d.amount is int && d.amount > 0 && d.amount <= 1000000000
             && str(d.currency, 5)
             && str(d.label, 140)
             && str(d.categoryId, 64)
             && isIsoDate(d.date)
             && d.isRecurring is bool
             && (!('recurringFrequency' in d)
                 || d.recurringFrequency in ['weekly', 'monthly', 'quarterly', 'yearly'])
             && (!('nextDueDate' in d) || isIsoDate(d.nextDueDate))
             && optionalStr(d, 'activityId', 64)
             && optionalStr(d, 'iconOverride', 48)
             && optionalStr(d, 'note', 800)
             // Image en base64 : bornée pour rester sous la limite de 1 Mio/document.
             && optionalStr(d, 'imageUrl', 400000)
             && d.badges is list && d.badges.size() <= 24
             // Ventilation : le détail de chaque part n'est pas inspectable
             // ici (pas de boucle dans les règles), on borne donc le nombre.
             && (!('splits' in d) || (d.splits is list && d.splits.size() <= 20))
             && optionalStr(d, 'externalId', 64)
             && str(d.createdAt, 40)
             && str(d.updatedAt, 40);
    }

    // ------------------------------------------------------------ catégories

    function validCategory(d, catId) {
      return d.keys().hasAll(['id', 'label', 'scope', 'type', 'icon', 'color', 'keywords'])
             && d.keys().hasOnly(['id', 'label', 'scope', 'type', 'icon', 'color', 'keywords'])
             && d.id == catId
             && str(d.label, 60)
             && d.scope in ['perso', 'pro', 'both']
             && d.type in ['expense', 'revenue', 'both']
             && str(d.icon, 48)
             && isHexColor(d.color)
             && d.keywords is list && d.keywords.size() <= 80;
    }

    // --------------------------------------------------------------- badges

    function validBadge(d, badgeId) {
      return d.keys().hasAll(['id', 'label', 'color'])
             && d.keys().hasOnly(['id', 'label', 'color', 'icon'])
             && d.id == badgeId
             && str(d.label, 40)
             && isHexColor(d.color)
             && optionalStr(d, 'icon', 48);
    }

    // ---------------------------------------------------------- préférences

    function validSettings(d) {
      return d.keys().hasOnly([
               'currency', 'theme', 'savingsGoal',
               'monthStartDay', 'defaultScope', 'privacyMode',
               'usage', 'proEnabled', 'onboarded',
               'urssafRate', 'vatThreshold', 'revenueCeiling'
             ])
             && str(d.currency, 5)
             && d.theme in ['dark', 'light']
             && d.savingsGoal is number
             && d.savingsGoal >= 0
             && d.savingsGoal <= 1
             && (!('monthStartDay' in d)
                 || (d.monthStartDay is int && d.monthStartDay >= 1 && d.monthStartDay <= 28))
             && (!('defaultScope' in d) || d.defaultScope in ['perso', 'pro', 'both'])
             && (!('privacyMode' in d) || d.privacyMode is bool)
             && (!('usage' in d) || d.usage in ['perso', 'pro', 'both'])
             && (!('proEnabled' in d) || d.proEnabled is bool)
             && (!('onboarded' in d) || d.onboarded is bool)
             && (!('urssafRate' in d)
                 || (d.urssafRate is number && d.urssafRate >= 0 && d.urssafRate <= 1))
             && (!('vatThreshold' in d) || (d.vatThreshold is int && d.vatThreshold >= 0))
             && (!('revenueCeiling' in d) || (d.revenueCeiling is int && d.revenueCeiling >= 0));
    }

    // ------------------------------------------------------------- budgets

    function validBudget(d, budgetId) {
      return d.keys().hasOnly(['id', 'categoryId', 'scope', 'amount', 'rollover'])
             && d.id == budgetId
             && str(d.categoryId, 64)
             && d.scope in ['perso', 'pro', 'both']
             && d.amount is int && d.amount > 0 && d.amount <= 1000000000
             && (!('rollover' in d) || d.rollover is bool);
    }

    // --------------------------------------------------- échéances récurrentes

    function validScheduled(d, entryId) {
      return d.keys().hasAll(['id', 'label', 'type', 'scope', 'categoryId', 'amount', 'dayOfMonth', 'active'])
             && d.keys().hasOnly([
                  'id', 'label', 'type', 'scope', 'categoryId', 'activityId',
                  'amount', 'dayOfMonth', 'lastGenerated', 'active'
                ])
             && d.id == entryId
             && str(d.label, 140)
             && d.type in ['expense', 'revenue']
             && d.scope in ['perso', 'pro']
             && str(d.categoryId, 64)
             && optionalStr(d, 'activityId', 64)
             && d.amount is int && d.amount > 0 && d.amount <= 1000000000
             && d.dayOfMonth is int && d.dayOfMonth >= 1 && d.dayOfMonth <= 28
             && optionalStr(d, 'lastGenerated', 7)
             && d.active is bool;
    }

    // ------------------------------------------------------ objectifs d'épargne

    function validGoal(d, goalId) {
      return d.keys().hasAll(['id', 'label', 'target', 'saved', 'color', 'icon'])
             && d.keys().hasOnly(['id', 'label', 'target', 'saved', 'deadline', 'color', 'icon'])
             && d.id == goalId
             && str(d.label, 80)
             && d.target is int && d.target > 0 && d.target <= 1000000000
             && d.saved is int && d.saved >= 0 && d.saved <= 1000000000
             && (!('deadline' in d) || isIsoDate(d.deadline))
             && isHexColor(d.color)
             && str(d.icon, 48);
    }

    // ------------------------------------------- règles de catégorisation

    function validRule(d, ruleId) {
      return d.keys().hasAll(['id', 'label', 'active', 'order', 'field', 'operator', 'value', 'addBadges'])
             && d.keys().hasOnly([
                  'id', 'label', 'active', 'order', 'field', 'operator', 'value',
                  'type', 'scope', 'categoryId', 'addBadges', 'activityId',
                  'renameTo', 'markRecurring'
                ])
             && d.id == ruleId
             && str(d.label, 80)
             && d.active is bool
             && d.order is int && d.order >= 0 && d.order <= 10000
             && d.field in ['label', 'note', 'amount']
             && d.operator in ['contains', 'startsWith', 'equals', 'gt', 'lt']
             && str(d.value, 140)
             && (!('type' in d) || d.type in ['expense', 'revenue'])
             && (!('scope' in d) || d.scope in ['perso', 'pro'])
             && optionalStr(d, 'categoryId', 64)
             && optionalStr(d, 'activityId', 64)
             && optionalStr(d, 'renameTo', 140)
             && d.addBadges is list && d.addBadges.size() <= 24
             && (!('markRecurring' in d) || d.markRecurring is bool);
    }

    // ------------------------------------------------------------ activités

    function validActivity(d, activityId) {
      return d.keys().hasOnly(['id', 'label', 'color', 'icon', 'archived'])
             && d.id == activityId
             && str(d.label, 60)
             && isHexColor(d.color)
             && str(d.icon, 48)
             && d.archived is bool;
    }

    // ------------------------------------------------------------- chemins

    match /users/{userId} {

      // Le document racine n'est pas utilisé par l'app.
      allow read, write: if false;

      match /transactions/{txId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && validTransaction(request.resource.data, txId);
      }

      match /categories/{catId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && validCategory(request.resource.data, catId);
      }

      match /badges/{badgeId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && validBadge(request.resource.data, badgeId);
      }

      match /budgets/{budgetId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && validBudget(request.resource.data, budgetId);
      }

      match /activities/{activityId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && validActivity(request.resource.data, activityId);
      }

      match /scheduled/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && validScheduled(request.resource.data, entryId);
      }

      match /goals/{goalId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && validGoal(request.resource.data, goalId);
      }

      match /rules/{ruleId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && validRule(request.resource.data, ruleId);
      }

      match /meta/settings {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && validSettings(request.resource.data);
      }
    }

    // Tout chemin non prévu ci-dessus est refusé, sans exception.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ---------------------------------------------------------------------------
// App Check — à activer APRÈS avoir configuré App Check dans la console,
// sinon toutes les requêtes seront rejetées.
//
// Ajouter `&& request.app != null` à chaque condition isOwner(), ou remplacer
// l'assistant par :
//
//   function isOwner(userId) {
//     return request.auth != null
//            && request.auth.uid == userId
//            && request.app != null;
//   }
// ---------------------------------------------------------------------------
